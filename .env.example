# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (new key format). Legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional: legacy name, used as a fallback if the publishable key is unset
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for class emails (scheduled / rescheduled / cancelled). Leave unset to disable.
# Gmail: smtp.gmail.com, port 465, your address + an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to students, e.g. "Rookie <classes@yourdomain.com>" (defaults to SMTP_USER)
EMAIL_FROM=
